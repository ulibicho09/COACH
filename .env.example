# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local a GitHub.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo se usa en el servidor (cron). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Acceso (app de un solo usuario) ---
OWNER_EMAIL=ulisescerda41@gmail.com
# URL pública de la app. En local: http://localhost:3000
APP_URL=http://localhost:3000

# --- Anthropic (se usa desde la fase c) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Resend y cron (se usan en la fase f) ---
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
CRON_SECRET=

# --- Preferencias ---
USER_TIMEZONE=America/Mexico_City
CHECKIN_DAY=domingo
